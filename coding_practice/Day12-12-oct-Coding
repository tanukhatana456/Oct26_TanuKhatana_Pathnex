# Day12 - Scaling Application and Automation
# Ansible - Setup Auto-Scaling Group (ASG)
- name: Setup Auto Scaling Group
  hosts: all
  become: yes
  tasks:
    - name: Create Launch Configuration
      ec2_asg:
        name: tanudata-asg
	region: us-east-1
	launch_config_name: tanudata-launch-config
	min_size: 1
	max_size: 3
	desired_capacity: 2
	vpc_zone_identifier: subnet-12345678


# Terraform - Create a Load Balancer with EC2 Instances
resource "aws_lb" "tanudata_lb" {
  name 			= "tanudata-lb"
  internal 		= false
  load_balancer_type 	= "application"
  security_groups	= [aws_security_group.allow_ssh_http.id]
  subnets		= [aws_subnet.public.id]
}

resource "aws_instance" "tanudata_ec2" {
  ami			= "ami-0988u8u212u213"
  instance_type 	= "t2.micro"
  security_groups	= [aws_security_group.allow_ssh_http.name]
  tags = {
    NAME = "tanudata-EC2"
  }
}


# Kubernetes - Horizontal Pod Autoscaler (HPA) with Load Balancer
apiVersion: apps/v1
kind: Deployment
metadata:
  name: tanudata-web-app
spec: 
  replicas: 2
  selector:
    matchLabels:
      app: tanudata-web-app
  template:
    metadata:
      labels:
        app: tanudata-web-app
    spec:
      containers:
        - name: web
	  image: nginx
	  ports:
	    - containerPort: 80
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: tanudata-web-app-hpa
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: tanudata-web-app
  minReplicas: 1
  maxReplicas: 5
  targetCPUUtilizationPercentage: 80
 



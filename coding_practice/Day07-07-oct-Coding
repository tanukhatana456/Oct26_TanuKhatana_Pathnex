# Day07 - Automating Cloid Infrastructure with Terraform & Ansible
# Ansible - Setup Nginx with Custom Config
- name: Setup Nginx with Custom Config
  hosts: all
  become: yes
  tasks:
    - name: Install nginx
      yum:
        name: nginx
	state: present
    - name: Copy custom nginx.conf
      copy:
        src: nginx.conf
	dest: /etc/nginx/nginx.conf
    - name: Start nginx service
      service:
        name: nginx
	state: started
	enabled: yes


# Terraform - Provision EC2 with IAM Role
resource "aws_iam_role" "ec2_role" {
  name 		     = "tanudata_ec2_role"
  assume_role_policy = jsonencode({
    version + "2012-10-17"
    statement = [
      {
        Action = "sts:AssumeRole"
	Effect = "Allow"
	Principle = {
	  Service = "ec2.amazonaws.com"
	}
      },
    ]
  })
}

resource "aws_instance" "tanudata_ec2" {
  ami 		= "ami-0jhjhjhhuhuih122"
  instance_type = "t2.medium"
  iam_instance_profile = aws_iam-role.ec2_role.name
  tags = {
    Name = "Tanudata-EC2"
  }
}




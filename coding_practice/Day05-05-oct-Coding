# GitLab CI/CD - With Docker Build
stages:
  - build
  - push
  - deploy

build:
  stage: build
  script:
    - docker build -t tanudata-app .

push:
  stage: push
  script:
    - docker push tanudata-app

deploy:
  stage: deploy
  script:
    - kubectl apply -f kubernetes/deployment.yaml



# Ansible - Create User and set permissions

- name: Create a new user
  hosts: all
  become: yes
  tasks: 
    - name: Create User
      user: 
        name: tanudata
	state: present
	shell: /bin/bash
    -name: Set permissions for the user
     file:
       path: /home/tanudata
        owner: tanudata
	group: tanudata
	mode: '0755'



# Terraform - EC2 With Tags and Volume
 resource "aws_instance" "pathnexEC2" {
   ami = "ami_0hdhhwbdb11212"
   instance_type = "t2.medium"

   tags = {
      name = "tanudata-server"
   }

   ebs_block_device {
     device_name = "/dev/sdh"
     volume_sixe = 50
   }
}




# GitLab CI/CD - Multi-stage Deployment with Helm
stages:
  - build
  - push
  - deploy

build:
  stage: build
  script:
    - docker build -t tanudata-web-app .

push:
  stage: push
  script:
    - docker login -u "$CI_REGISTRY_USER" -p "$CI_REGISTRY_PASSWORD"
    - docker push tanudata-web-app

deploy:
  stage: deploy
  script:
    - helm update --install tanudata-nginx tanudata/nginx-ingress





# JenkinsFile - Basic CI Pipeline
pipeline {
    agent any
    stages {
       stage('Build') {
           steps {
	       echo 'Building project'
	     }
	 }
	 stage('Test') {
	     steps {
	         echo 'Running Tests'
	     }
	 }
	 stage('Deploy') {
	     steps {
	         echo 'Deploying Application'
	     }
	 }
     }
}




# GitLab CI/CD - Basic Pipeline
stages:
  - build
  - test
  - deploy

build;
  stage: build
  script:
    - echo "Building Project"

test: 
  stage: test
  script:
    - echo "Running Tests"

deploy:
  stage: deploy
  script:
    - echo "Deploying Application"




# Ansible - Install and Configure Nginx
- name: Install and configure Nginx
  hosts: all
  become: yes
  tasks: 
    - name: Install nginx
      yum:
        name: nginx
	state: present
    - name: Configure nginx
      template:
        src: nginx.conf.j2
	dest: /etc/nginx/nginx.conf
    - name: Start nginx service
      service:
        name: nginx
	state: started
	enabled: yes


# Terraform - EC2 with Security Groups
resource "aws_security_group" "example" {
  name = "example_security_group"
  description = "Allow SSH and HTTP"
  ingress {
    from_port = 22
    to_port = 22
    protocol ="tcp"
    cidr_blocks = ["1.2.3.4/5"]
  }
  ingress {
    from_port = 80
    to_port   = 80
    protocol  = "tcp"
    cidr_blocks = ["1.2.3.4/5"]
  }
  ingress {
    from_port = 0
    to_port   = 2
    protocol  = "-1"
    cidr_blocks = ["4.5.6.7/8"]
  }
}


